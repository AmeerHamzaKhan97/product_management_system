            "url": {
              "raw": "{{baseUrl}}/products/import",
              "host": ["{{baseUrl}}"],
              "path": ["products", "import"]
            },
            "description": "Uploads a CSV file for bulk product import. The file is queued for background processing. Returns 202 with the BullMQ `jobId` immediately.\n\n**CSV format:**\n```\nProduct Name,Category,Price,Image URL\nGaming Laptop,Electronics,1299.99,https://example.com/images/gaming-laptop.jpg\n```"
          },
          "response": [
            {
              "name": "202 Accepted – Import queued",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] },
                "url": { "raw": "{{baseUrl}}/products/import", "host": ["{{baseUrl}}"], "path": ["products", "import"] }
              },
              "status": "Accepted",
              "code": 202,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
